{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Taobao reconciliation input v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "shopKey",
    "period",
    "accounts",
    "inputs",
    "balances"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "shopKey": {
      "type": "string"
    },
    "period": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "accounts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "source",
          "accountId"
        ],
        "properties": {
          "source": {
            "enum": [
              "alipay",
              "aggregate",
              "deposit"
            ]
          },
          "accountId": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "tbcli manifest paths relative to input file"
    },
    "balances": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bindingConfirmed": {
      "type": "boolean"
    },
    "balancePolicy": {
      "type": "object",
      "properties": {
        "allowConfirmed": {"type": "boolean"},
        "allowReconstructed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "requiredDatasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "dataset"
        ]
      }
    },
    "rules": {
      "type": "array",
      "description": "source/dataset/descriptionIncludes/category; categories: sales refund marketing software consumer-service compensation freight transfer deposit-debit external-in external-out unknown"
    },
    "transferPairs": {
      "type": "array",
      "description": "from:{source,id},to:{source,id},evidence:string; distinct account and opposite equal amount"
    }
  }
}
